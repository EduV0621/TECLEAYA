# Copia este archivo como ".env" y completa tus propios valores.
# NUNCA subas el archivo ".env" real a GitHub.

# Flask
SECRET_KEY=cambia-esta-clave-por-una-segura
FLASK_DEBUG=True
PORT=5000

# Firebase Admin SDK
# Estos valores se obtienen del archivo JSON de credenciales de tu
# proyecto Firebase (Configuración del proyecto > Cuentas de servicio).
FIREBASE_PROJECT_ID=tu-project-id
FIREBASE_CLIENT_EMAIL=tu-cuenta-de-servicio@tu-project-id.iam.gserviceaccount.com
# La clave privada debe mantener los "\n" literales tal como aparecen
# en el JSON descargado; el código se encarga de convertirlos en saltos
# de línea reales.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_AQUI\n-----END PRIVATE KEY-----\n"
